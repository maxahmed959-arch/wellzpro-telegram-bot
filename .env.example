# Firebase — لتوليد أكواد التفعيل من البوت مباشرة (مطلوب لـ /gen)
# الصق محتوى service-account.json كاملاً في سطر واحد:
FIREBASE_SERVICE_ACCOUNT=
# FIREBASE_DATABASE_URL=https://samuraibot-acc00-7ea81-default-rtdb.firebaseio.com
# FIREBASE_LICENSES_PATH=licenses
# سوبر أدمن (إدارة المسؤولين + حذف/إيقاف)
# SUPER_ADMIN_IDS=123456789
# SUPER_ADMIN_PIN=WellzPro2026
# RATE_LIMIT_PER_MINUTE=5
# AUTO_DELIVER_ON_PROOF=false
# EXPIRY_REMINDER_DAYS=3
# للسحابة (Render) — يُولَّد تلقائياً على Render
# TELEGRAM_WEBHOOK_SECRET=
# BOT_PUBLIC_URL=https://wellzpro-telegram-bot.onrender.com
# تحميل APK — 3 أزرار (يُبنى تلقائياً من repo + release)
# APP_DOWNLOAD_GITHUB_REPO=maxahmed959-arch/wellzpro-telegram-bot
# APP_DOWNLOAD_RELEASE=v1.0.0
# أو روابط مخصصة:
# APP_DOWNLOAD_URL_V8A=https://github.com/.../releases/download/v1.0.0/v8a.apk
# APP_DOWNLOAD_URL_V7A=https://github.com/.../releases/download/v1.0.0/v7a.apk
# APP_DOWNLOAD_URL_SAMU=https://github.com/.../releases/download/v1.0.0/samu.8.apk
# رابط واحد فقط (قديم):
# APP_DOWNLOAD_URL=https://github.com/USER/REPO/releases/download/v1.0/v8a.apk
# فيديو زر «طريقة التشغيل» — رابط mp4 مباشر أو file_id من تيليجرام (أرسل الفيديو للبوت ثم /videoid)
# HOW_TO_RUN_VIDEO_URL=https://example.com/how-to-run.mp4
# HOW_TO_RUN_VIDEO_FILE_ID=  ← من /videoid بعد إرسال الفيديو للبوت
